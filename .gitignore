# Rust
/target

# SQLx offline query cache (uncomment if using `cargo sqlx prepare`)
# .sqlx

# Environment variables
.env
.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local clone of the Keeplin client (used for reference)
keeplin/
# Graphify knowledge graph: generated and published by CI, never versioned.
graphify-out/
